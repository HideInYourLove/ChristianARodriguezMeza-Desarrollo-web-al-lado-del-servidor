<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cool Center | Tienda Online</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif}
body{background:#f4f6f8;color:#333}
header{
  background:linear-gradient(135deg,#1e3c72,#2a5298);
  color:white;
  padding:20px 40px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
}
nav a{color:white;margin-left:20px;text-decoration:none}
nav a:hover{opacity:.7}
button{
  background:#2a5298;
  color:white;
  border:none;
  padding:12px 25px;
  border-radius:25px;
  cursor:pointer;
}
button:hover{background:#1e3c72}
.container{max-width:1200px;margin:auto;padding:40px}
.hidden{display:none}

.hero{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:40px;
  background:white;
}
.hero img{width:100%;border-radius:20px}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:25px;
}
.card{
  background:white;
  padding:20px;
  border-radius:20px;
  box-shadow:0 10px 25px rgba(0,0,0,.08);
}
.card img{
  width:100%;
  height:200px;
  object-fit:cover;
  border-radius:15px;
}
.price{font-weight:700;margin:10px 0}

.features{margin:15px 0;padding-left:20px}
.features li{margin-bottom:6px;color:#555}

input{
  width:100%;
  padding:10px;
  margin:10px 0;
  border-radius:10px;
  border:1px solid #ccc;
}

@media(max-width:768px){
  .hero{grid-template-columns:1fr}
}
</style>
</head>

<body>

<header>
  <h1>Cool Center</h1>
  <nav>
    <a href="#" onclick="mostrar('catalogo')">Inicio</a>
    <a href="#" onclick="verCarrito()">Carrito</a>
    <a href="#" onclick="mostrar('login')">Login</a>
    <a href="#" onclick="mostrar('registro')">Registro</a>
    <a href="#" id="logoutBtn" class="hidden" onclick="logout()">Salir</a>
  </nav>
</header>

<!-- HERO -->
<section class="container hero">
  <div>
    <h2>Tu tienda de tecnología favorita</h2>
    <p>Encuentra los mejores productos electrónicos al mejor precio.</p>
    <button onclick="mostrar('catalogo')">Ver productos</button>
  </div>
  <img src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8">
</section>

<!-- CATÁLOGO -->
<section id="catalogo" class="container">
  <h2>Productos</h2>
  <div id="listaProductos" class="grid"></div>
</section>

<!-- DETALLE -->
<section id="detalle" class="container hidden">
  <button onclick="mostrar('catalogo')">← Volver</button>
  <div class="card">
    <img id="dImg">
    <h2 id="dNombre"></h2>
    <div class="price" id="dPrecio"></div>
    <ul id="dFeatures" class="features"></ul>
    <button onclick="agregarCarrito()">Agregar al carrito</button>
  </div>
</section>

<!-- CARRITO -->
<section id="carrito" class="container hidden">
  <h2>Carrito</h2>
  <div id="listaCarrito"></div>
  <h3 id="totalCarrito"></h3>
  <button onclick="mostrar('catalogo')">Seguir comprando</button>
</section>

<!-- LOGIN -->
<section id="login" class="container hidden">
  <h2>Iniciar sesión</h2>
  <input type="email" id="loginEmail" placeholder="Email">
  <input type="password" id="loginPass" placeholder="Contraseña">
  <button onclick="login()">Entrar</button>
</section>

<!-- REGISTRO -->
<section id="registro" class="container hidden">
  <h2>Registro</h2>
  <input type="text" id="regNombre" placeholder="Nombre">
  <input type="email" id="regEmail" placeholder="Email">
  <input type="password" id="regPass" placeholder="Contraseña">
  <button onclick="registrar()">Registrarse</button>
</section>

<script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

<script>
/* ===== UTIL ===== */
function mostrar(id){
  document.querySelectorAll("section").forEach(s=>s.classList.add("hidden"));
  document.getElementById(id).classList.remove("hidden");
}

/* ===== AUTH ===== */
let usuarios = JSON.parse(localStorage.getItem("usuarios")) || [];
let usuarioActivo = JSON.parse(localStorage.getItem("usuarioActivo")) || null;

function hash(t){ return btoa(t); }

function registrar(){
  if(!regNombre.value||!regEmail.value||!regPass.value)
    return toast("Todos los campos son obligatorios");
  usuarios.push({email:regEmail.value,pass:hash(regPass.value)});
  localStorage.setItem("usuarios",JSON.stringify(usuarios));
  toast("Registro exitoso");
  mostrar("login");
}

function login(){
  let u = usuarios.find(u=>u.email==loginEmail.value && u.pass==hash(loginPass.value));
  if(!u) return toast("Credenciales incorrectas");
  usuarioActivo = u;
  localStorage.setItem("usuarioActivo",JSON.stringify(u));
  document.getElementById("logoutBtn").classList.remove("hidden");
  toast("Bienvenido");
  mostrar("catalogo");
}

function logout(){
  usuarioActivo=null;
  localStorage.removeItem("usuarioActivo");
  document.getElementById("logoutBtn").classList.add("hidden");
  toast("Sesión cerrada");
}

/* ===== PRODUCTOS (15 Modelos de Alta Gama) ===== */
